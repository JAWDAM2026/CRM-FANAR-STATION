{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "CRM staff profile for Fanar Energy Fuel staff across five operational roles.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["agent", "station_supervisor", "manager", "quality_auditor", "system_admin"]
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "role", "branch", "createdAt", "updatedAt"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Fanar Energy Fuel customer directory record.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "preferredBranch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "segment": {
          "type": "string",
          "enum": ["individual", "fleet", "corporate"]
        },
        "totalComplaints": {
          "type": "integer"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["name", "phone", "city", "preferredBranch", "segment", "totalComplaints", "ownerId", "createdAt", "updatedAt"]
    },
    "Complaint": {
      "title": "Complaint",
      "description": "Customer complaint ticket with SLA tiers P1-P4, lifecycle state machine, pause tracking, escalation matrix, CSAT, and bounded audit trail.",
      "type": "object",
      "properties": {
        "ticketCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^FNR-[0-9A-Z\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "pumpNumber": {
          "type": "string",
          "maxLength": 20
        },
        "category": {
          "type": "string",
          "enum": ["fuel_quality", "billing_pump", "cleanliness_facilities", "staff_service", "fleet_cards", "other"]
        },
        "channel": {
          "type": "string",
          "enum": ["whatsapp", "phone", "direct", "portal"]
        },
        "priority": {
          "type": "string",
          "enum": ["normal", "high", "urgent"]
        },
        "slaTier": {
          "type": "string",
          "enum": ["P1", "P2", "P3", "P4"]
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "waiting_customer", "pending_manager", "resolved", "closed", "reopened", "cancelled"]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "aiSummary": {
          "type": "string",
          "maxLength": 1000
        },
        "codeSentViaWhatsapp": {
          "type": "boolean"
        },
        "stationUnknown": {
          "type": "boolean"
        },
        "attachmentMeta": {
          "type": "object",
          "description": "Optional attachment file metadata (name, MIME type, byte size)."
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "firstResponseAt": {
          "type": "string",
          "format": "date-time"
        },
        "resolvedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pausedAt": {
          "type": "string",
          "format": "date-time"
        },
        "pausedTotalMinutes": {
          "type": "integer"
        },
        "pauseCount": {
          "type": "integer"
        },
        "pauseReason": {
          "type": "string",
          "maxLength": 400
        },
        "pauseReminderAt": {
          "type": "string",
          "maxLength": 60
        },
        "escalationLevel": {
          "type": "integer"
        },
        "escalationOwner": {
          "type": "string",
          "maxLength": 120
        },
        "resolutionEvidence": {
          "type": "string",
          "maxLength": 600
        },
        "publicUpdateNote": {
          "type": "string",
          "maxLength": 600
        },
        "customerConfirmed": {
          "type": "boolean"
        },
        "csatScore": {
          "type": "integer"
        },
        "csatComment": {
          "type": "string",
          "maxLength": 600
        },
        "reopenCount": {
          "type": "integer"
        },
        "reopenReason": {
          "type": "string",
          "maxLength": 400
        },
        "previousSolution": {
          "type": "string",
          "maxLength": 600
        },
        "cancellationReason": {
          "type": "string",
          "maxLength": 400
        },
        "auditTrail": {
          "type": "array",
          "description": "Bounded timestamped action audit trail (up to 30 entries)."
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "assignedAgentName": {
          "type": "string",
          "maxLength": 100
        },
        "managerNotes": {
          "type": "string",
          "maxLength": 2000
        },
        "closureReason": {
          "type": "string",
          "maxLength": 200
        },
        "closedBy": {
          "type": "string",
          "maxLength": 120
        },
        "closedAt": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketCode",
        "customerId",
        "customerName",
        "customerPhone",
        "branch",
        "pumpNumber",
        "category",
        "channel",
        "priority",
        "status",
        "description",
        "aiSummary",
        "codeSentViaWhatsapp",
        "ownerId",
        "assignedAgentName",
        "managerNotes",
        "closureReason",
        "closedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "WhatsApp conversation thread with AI auto-reply state and 5-rule escalation tracking.",
      "type": "object",
      "properties": {
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "aiAutoReplyEnabled": {
          "type": "boolean"
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 1000
        },
        "linkedTicketCode": {
          "type": "string",
          "maxLength": 32
        },
        "unreadCount": {
          "type": "integer"
        },
        "handoffStatus": {
          "type": "string",
          "enum": ["bot_active", "escalated_to_agent", "agent_handling"]
        },
        "handoffReason": {
          "type": "string",
          "maxLength": 400
        },
        "handoffAt": {
          "type": "string",
          "format": "date-time"
        },
        "lastIntent": {
          "type": "string",
          "enum": ["greeting", "faq", "order_status", "complaint", "escalation", "unknown"]
        },
        "escalationRule": {
          "type": "string",
          "enum": ["none", "explicit_request", "missing_knowledge", "sensitive_case", "repeated_failure", "angry_or_reopen"]
        },
        "consecutiveAiFailures": {
          "type": "integer"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "customerId",
        "customerName",
        "customerPhone",
        "aiAutoReplyEnabled",
        "lastMessage",
        "linkedTicketCode",
        "unreadCount",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "WhatsappMessage": {
      "title": "WhatsappMessage",
      "description": "Individual WhatsApp message within a conversation.",
      "type": "object",
      "properties": {
        "sender": {
          "type": "string",
          "enum": ["customer", "ai", "agent"]
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "messageType": {
          "type": "string",
          "enum": ["text", "ticket_code", "closure_notice", "handoff_notice"]
        },
        "ticketCode": {
          "type": "string",
          "maxLength": 32
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sender", "senderName", "body", "messageType", "ticketCode", "ownerId", "createdAt"]
    },
    "CallLog": {
      "title": "CallLog",
      "description": "Incoming/outbound call log handled by AI IVR or customer service agent.",
      "type": "object",
      "properties": {
        "callerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "callerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "branch": {
          "type": "string",
          "maxLength": 100
        },
        "durationSeconds": {
          "type": "integer"
        },
        "handledBy": {
          "type": "string",
          "enum": ["ai_ivr", "agent"]
        },
        "transcript": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "aiSummary": {
          "type": "string",
          "maxLength": 1000
        },
        "linkedTicketCode": {
          "type": "string",
          "maxLength": 32
        },
        "codeSentViaWhatsapp": {
          "type": "boolean"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "callerName",
        "callerPhone",
        "branch",
        "durationSeconds",
        "handledBy",
        "transcript",
        "aiSummary",
        "linkedTicketCode",
        "codeSentViaWhatsapp",
        "ownerId",
        "createdAt"
      ]
    },
    "WhatsappBotConfig": {
      "title": "WhatsappBotConfig",
      "description": "Editable AI WhatsApp chatbot knowledge base, working hours, FAQs, and escalation rules.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "botName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "officialWhatsappNumber": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "welcomeMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "toneInstruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "autoEscalateComplex": {
          "type": "boolean"
        },
        "escalationMessage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "workingHoursSummary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "productsInfo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "servicesInfo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "branchesInfo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "faqs": {
          "type": "array",
          "description": "Bounded list of up to 30 FAQ items."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "botName",
        "welcomeMessage",
        "toneInstruction",
        "autoEscalateComplex",
        "escalationMessage",
        "workingHoursSummary",
        "productsInfo",
        "servicesInfo",
        "branchesInfo",
        "faqs",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "QualityAudit": {
      "title": "QualityAudit",
      "description": "Weighted 5-criteria quality audit score record for complaint sampling.",
      "type": "object",
      "properties": {
        "complaintId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ticketCode": {
          "type": "string",
          "minLength": 6,
          "maxLength": 32,
          "pattern": "^FNR-[0-9A-Z\\-]+$"
        },
        "stationName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "auditorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "problemUnderstanding": {
          "type": "integer"
        },
        "communication": {
          "type": "integer"
        },
        "solutionAndEvidence": {
          "type": "integer"
        },
        "recordCompleteness": {
          "type": "integer"
        },
        "privacyCompliance": {
          "type": "integer"
        },
        "totalScore": {
          "type": "integer"
        },
        "improvementNotes": {
          "type": "string",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "enum": ["passed", "needs_improvement"]
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "complaintId",
        "ticketCode",
        "stationName",
        "auditorName",
        "problemUnderstanding",
        "communication",
        "solutionAndEvidence",
        "recordCompleteness",
        "privacyCompliance",
        "totalScore",
        "improvementNotes",
        "status",
        "monthKey",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActionPlanItem": {
      "title": "ActionPlanItem",
      "description": "Monthly governance corrective action item tracked across Fanar stations and CS operations.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rootCause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "dueDateLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "targetMetric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "enum": ["open", "in_progress", "completed"]
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "title",
        "rootCause",
        "ownerName",
        "dueDateLabel",
        "targetMetric",
        "status",
        "monthKey",
        "ownerId",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile and RBAC role document for Fanar staff."
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/Customer" },
      "description": "Customer directory documents."
    },
    "/complaints/{complaintId}": {
      "schema": { "$ref": "#/entities/Complaint" },
      "description": "Complaint tickets registered via WhatsApp, Call Center, Portal, or direct agent entry."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "WhatsApp conversation headers with AI auto-reply and 5-rule escalation state."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/WhatsappMessage" },
      "description": "Messages inside a WhatsApp conversation."
    },
    "/call_logs/{callId}": {
      "schema": { "$ref": "#/entities/CallLog" },
      "description": "AI IVR and agent call records."
    },
    "/bot_configs/{configId}": {
      "schema": { "$ref": "#/entities/WhatsappBotConfig" },
      "description": "Saved AI WhatsApp chatbot knowledge base and escalation settings."
    },
    "/quality_audits/{auditId}": {
      "schema": { "$ref": "#/entities/QualityAudit" },
      "description": "Weighted 5-criteria quality audit reviews of sampled complaints."
    },
    "/action_plans/{planId}": {
      "schema": { "$ref": "#/entities/ActionPlanItem" },
      "description": "Monthly operational corrective action plan items."
    }
  }
}
